<UserControl x:Class="SCADA_VERTEX.frm_alarm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <Style x:Key="BlockBorder" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="LblText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="BtnQuery" TargetType="Button">
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnTabAlarm" TargetType="Button">
            <Setter Property="Background" Value="#A6A6A6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Nút chuyển Tab -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="btnTabCurrent" Content="CURRENT ALARM" Style="{StaticResource BtnTabAlarm}" Click="btnTabCurrent_Click" Background="#00A2E8" Foreground="White"/>
            <Button x:Name="btnTabHistory" Content="HISTORY ALARM" Style="{StaticResource BtnTabAlarm}" Click="btnTabHistory_Click"/>
        </StackPanel>

        <!-- Tiêu đề Header cho phần Query -->
        <Border Grid.Row="2" Background="#A6A6A6" BorderBrush="#333" BorderThickness="1,1,1,0" Padding="10,2">
            <TextBlock x:Name="txtModeTitle" Text="CURRENT ALARM MONITOR" FontWeight="Bold" HorizontalAlignment="Center" FontSize="12"/>
        </Border>

        <!-- Panel tìm kiếm (Chỉ hiện khi ở Tab History) -->
        <Border x:Name="bdrQuery" Grid.Row="3" Style="{StaticResource BlockBorder}" Padding="15,8" Visibility="Collapsed">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="FROM" Style="{StaticResource LblText}"/>
                <DatePicker x:Name="dtpAlarmFrom" Width="140" Height="26" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtAlarmFromTime" Width="50" Height="26" VerticalContentAlignment="Center" Margin="0,0,30,0" Text="00:00"/>

                <TextBlock Text="TO" Style="{StaticResource LblText}"/>
                <DatePicker x:Name="dtpAlarmTo" Width="140" Height="26" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtAlarmToTime" Width="50" Height="26" VerticalContentAlignment="Center" Margin="0,0,30,0" Text="23:59"/>

                <TextBlock Text="Keyword:" Style="{StaticResource LblText}"/>
                <TextBox x:Name="txtAlarmKeyword" Width="250" Height="26" VerticalContentAlignment="Center" Margin="0,0,40,0"/>

                <Button x:Name="btnQueryAlarm" Content="QUERY" Style="{StaticResource BtnQuery}" Background="#0054A6" Click="btnQueryAlarm_Click"/>
                <Button x:Name="btnExportAlarm" Content="EXPORT" Style="{StaticResource BtnQuery}" Background="#28A745" Margin="20,0,0,0" Click="btnExportAlarm_Click"/>
            </WrapPanel>
        </Border>

        <!-- Khu vực hiển thị bảng dữ liệu -->
        <Border Grid.Row="5" Style="{StaticResource BlockBorder}" Padding="5">
            <Grid>
                <!-- BẢNG CURRENT ALARM -->
                <DataGrid x:Name="dgvCurrentAlarm" AutoGenerateColumns="False" CanUserAddRows="False" 
                          RowHeaderWidth="0" Background="White" BorderBrush="#999" BorderThickness="1"
                          HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" RowHeight="30"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="#555555"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Trigger Time" Binding="{Binding Time}" Width="Auto" MinWidth="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name Alarm" Binding="{Binding AlarmName}" Width="*" MinWidth="250" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Solution" Binding="{Binding Solution}" Width="*" MinWidth="350" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Alarm Code" Binding="{Binding AlarmCode}" Width="Auto" MinWidth="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- BẢNG HISTORY ALARM (Ẩn ban đầu) -->
                <DataGrid x:Name="dgvAlarmLog" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Visibility="Collapsed"
                          RowHeaderWidth="0" Background="White" BorderBrush="#999" BorderThickness="1"
                          HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" RowHeight="30"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Background" Value="#555555"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="Auto" MinWidth="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name Alarm" Binding="{Binding AlarmName}" Width="*" MinWidth="250" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Solution" Binding="{Binding Solution}" Width="*" MinWidth="350" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Alarm Code" Binding="{Binding AlarmCode}" Width="Auto" MinWidth="120" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>