<UserControl x:Class="SCADA_VERTEX.frm_Logs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="BlockBorder" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="LblText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="BtnAction" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="110"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#999" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- KHU VỰC BỘ LỌC ĐÃ ĐƯỢC THÊM COMBOBOX TEST TYPE -->
        <Border Grid.Row="0" Style="{StaticResource BlockBorder}" Padding="10,5">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="FROM" Style="{StaticResource LblText}"/>
                <DatePicker x:Name="dtpFrom" Width="110" Height="26" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtFromTime" Text="00:00" Width="45" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0" HorizontalContentAlignment="Center" ToolTip="Nhập giờ HH:mm"/>

                <TextBlock Text="TO" Style="{StaticResource LblText}"/>
                <DatePicker x:Name="dtpTo" Width="110" Height="26" Margin="0,0,5,0" VerticalContentAlignment="Center"/>
                <TextBox x:Name="txtToTime" Text="23:59" Width="45" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0" HorizontalContentAlignment="Center" ToolTip="Nhập giờ HH:mm"/>

                <TextBlock Text="Barcode" Style="{StaticResource LblText}"/>
                <TextBox x:Name="txtSearchBarcode" Width="130" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                <TextBlock Text="Result" Style="{StaticResource LblText}"/>
                <ComboBox x:Name="cmbSearchResult" Width="85" Height="26" VerticalContentAlignment="Center" Margin="0,0,15,0">
                    <ComboBoxItem Content="All" IsSelected="True"/>
                    <ComboBoxItem Content="OK"/>
                    <ComboBoxItem Content="Error"/>
                </ComboBox>

                <!-- [MỚI]: COMBOBOX CHỌN LOẠI XÉT NGHIỆM -->
                <TextBlock Text="Test Type" Style="{StaticResource LblText}"/>
                <ComboBox x:Name="cmbSearchTestType" Width="150" Height="26" VerticalContentAlignment="Center" SelectedIndex="0">
                    <ComboBoxItem Content="All" Tag="All"/>
                    <ComboBoxItem Content="Hematology" Tag="Hematology"/>
                    <ComboBoxItem Content="Chemistry" Tag="Chemistry"/>
                    <ComboBoxItem Content="Immunity" Tag="Immunity"/>
                    <ComboBoxItem Content="Error Tray" Tag="Unknown"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource BlockBorder}" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnToday" Content="TODAY" Background="#A6A6A6" Foreground="Black" Style="{StaticResource BtnAction}" Click="btnToday_Click"/>
                    <Button x:Name="btnClear" Content="CLEAR" Background="#A6A6A6" Foreground="Black" Style="{StaticResource BtnAction}" Click="btnClear_Click"/>
                    <Button x:Name="btnSearch" Content="SEARCH" Background="#0054A6" Foreground="White" Style="{StaticResource BtnAction}" Click="btnSearch_Click"/>
                    <Button x:Name="btnExportCSV" Content="EXPORT CSV" Background="#FF7F27" Foreground="White" Style="{StaticResource BtnAction}" Click="btnExportCSV_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL" Style="{StaticResource LblText}"/>
                    <TextBox x:Name="txtTotalCount" Width="70" Height="26" IsReadOnly="True" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="OK" Style="{StaticResource LblText}"/>
                    <TextBox x:Name="txtOkCount" Width="70" Height="26" IsReadOnly="True" Background="#D5F5E3" Foreground="#1D8348" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,15,0"/>

                    <TextBlock Text="ERR" Style="{StaticResource LblText}"/>
                    <TextBox x:Name="txtErrCount" Width="70" Height="26" IsReadOnly="True" Background="#FADBD8" Foreground="#C0392B" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource BlockBorder}" Padding="5">
            <!-- Đã bật thuộc tính cuộn ngang HorizontalScrollBarVisibility="Auto" và tháo khóa các Width cột -->
            <DataGrid x:Name="dgvDataLog" AutoGenerateColumns="False" CanUserAddRows="False" 
                      RowHeaderWidth="0" Background="White" BorderBrush="#999" BorderThickness="1"
                      HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" RowHeight="30"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AlternationCount="2" 
                      AlternatingRowBackground="#EAF2F8" CanUserResizeColumns="True">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Background" Value="#A6A6A6"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Result}" Value="OK">
                                <Setter Property="Background" Value="#B5E61D"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Result}" Value="Error">
                                <Setter Property="Background" Value="#FF9933"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- CÁC CỘT THỜI GIAN ĐÃ ĐƯỢC DỜI XUỐNG DƯỚI CÙNG -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Binding="{Binding No}" Width="50" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Batch Name" Binding="{Binding BatchName}" Width="180" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#0054A6"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="250" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Margin" Value="8,0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- [DỜI XUỐNG DƯỚI CÙNG]: CỘT START TIME -->
                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- [DỜI XUỐNG DƯỚI CÙNG]: CỘT END TIME (TIME SCAN) -->
                    <DataGridTextColumn Header="End Time (Scan)" Binding="{Binding TimeScan, StringFormat=\{0:dd/MM/yyyy HH:mm:ss\}}" Width="150" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- [DỜI XUỐNG DƯỚI CÙNG]: CỘT DURATION (THỜI GIAN T) -->
                    <DataGridTextColumn Header="Duration (s)" Binding="{Binding DurationSec, StringFormat=\{0:F2\}}" Width="100" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="DarkRed"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>