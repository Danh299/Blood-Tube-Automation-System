<UserControl x:Class="SCADA_VERTEX.frm_main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="BlockBorder" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="MonitorHeader" TargetType="Border">
            <Setter Property="Background" Value="#555555"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="CornerRadius" Value="3,3,0,0"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>

        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#666"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BtnOut" TargetType="Button">
            <Setter Property="Background" Value="#A6A6A6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5,10,5,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="BlackBoxInfo" TargetType="Border">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="TubeIndicator" TargetType="Border">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="Background" Value="#444444"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#7F7F7F" BorderBrush="#333" BorderThickness="1" CornerRadius="3">
            <UniformGrid Columns="1" Margin="0,10">
                <Button Click="btn_Start" Style="{StaticResource SidebarBtn}" Background="#7ED957" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment= "Stretch" VerticalAlignment="Stretch" MinWidth="80">
                        <Ellipse x:Name="led_Start" Width="10" Height="10" Fill="Gray" Stroke="#555" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-10,0,0"/>
                        <TextBlock Text="START" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    </Grid>
                </Button>

                <Button Click="btn_Stop" Style="{StaticResource SidebarBtn}" Background="#FF3333" Foreground="White" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="80">
                        <Ellipse x:Name="led_Stop" Width="10" Height="10" Fill="Gray" Stroke="#555" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="0,-10,0,0"/>
                        <TextBlock Text="STOP" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    </Grid>
                </Button>

                <Button Click="btn_ResetAll_Click" Style="{StaticResource SidebarBtn}" Background="#FFD700" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinWidth="80">
                        <Ellipse x:Name="led_Reset" Width="10" Height="10" Fill="Gray" Stroke="#555" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"  Margin="0,-10,0,0"/>
                        <TextBlock Text="RESET" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,5"/>
                    </Grid>
                </Button>

                <Button Content="AUTO" Style="{StaticResource SidebarBtn}" Background="White" Click="btn_AutoMode" />
                <Button Content="MAN" Style="{StaticResource SidebarBtn}" Background="White" Click="btn_ManualMode"/>
                <Button Content="TAKE" Style="{StaticResource SidebarBtn}" Background="#00BFFF" Foreground="Black" Click="btn_LayKhay_Click"/>
            </UniformGrid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="10*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource BlockBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource MonitorHeader}">
                        <TextBlock Text="Sort monitor" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="10,15,10,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TRAY 1" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="Nen1" Background="#666666" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Border x:Name="T1_Slot6" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot7" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot4" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot5" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot2" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot3" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot0" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T1_Slot1" Style="{StaticResource TubeIndicator}"/>
                                    </UniformGrid>
                                    <Button x:Name="btnOut1" Content="OUT1" Style="{StaticResource BtnOut}" Click="btn_ResetTray1"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TRAY 2" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="Nen2" Background="#666666" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Border x:Name="T2_Slot6" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot7" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot4" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot5" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot2" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot3" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot0" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T2_Slot1" Style="{StaticResource TubeIndicator}"/>
                                    </UniformGrid>
                                    <Button x:Name="btnOut2" Content="OUT2" Style="{StaticResource BtnOut}" Click="btn_ResetTray2"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TRAY 3" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="Nen3" Background="#666666" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Border x:Name="T3_Slot6" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot7" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot4" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot5" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot2" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot3" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot0" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="T3_Slot1" Style="{StaticResource TubeIndicator}"/>
                                    </UniformGrid>
                                    <Button x:Name="btnOut3" Content="OUT3" Style="{StaticResource BtnOut}" Click="btn_ResetTray3"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="ERR" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="NenErr" Background="#666666" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <UniformGrid Columns="2">
                                        <Border x:Name="TErr_Slot6" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot7" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot4" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot5" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot2" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot3" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot0" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TErr_Slot1" Style="{StaticResource TubeIndicator}"/>
                                    </UniformGrid>
                                    <Button x:Name="btnOutErr" Content="OUT4" Style="{StaticResource BtnOut}" Click="btn_ResetTrayErr"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TG" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Border x:Name="NenTG" Background="#666666" CornerRadius="5" Padding="5">
                                <StackPanel>
                                    <UniformGrid Columns="3">
                                        <Border x:Name="Tube1_TG" Style="{StaticResource TubeIndicator}" Background="#FF9933"/>
                                        <Border x:Name="Tube2_TG" Style="{StaticResource TubeIndicator}" Background="#FF9933"/>
                                        <Border x:Name="Tube3_TG" Style="{StaticResource TubeIndicator}" Background="#FF9933"/>
                                        <Border x:Name="TG_Slot6" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot7" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot8" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot3" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot4" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot5" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot0" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot1" Style="{StaticResource TubeIndicator}"/>
                                        <Border x:Name="TG_Slot2" Style="{StaticResource TubeIndicator}"/>
                                    </UniformGrid>
                                    <Button x:Name="btnOutTg" Content="OUT" Style="{StaticResource BtnOut}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource BlockBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource MonitorHeader}">
                        <TextBlock Text="Centrifugation" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name="txt_Speed" Text="Speed:&#x0a;3000RPM" Foreground="#00FF00" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name="txt_Time" Text="Time:&#x0a;30s" Foreground="#00FF00" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name ="StatusCen"  Text="Status:&#x0a;Stop " Foreground="#00FF00" FontWeight="Bold" TextAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <Border Grid.Column="1" Background="White" BorderBrush="#999" BorderThickness="1" CornerRadius="5" Margin="10,0,0,0" Padding="15">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Viewbox Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Width="200" Height="200">
                                        <Ellipse x:Name="bg_LT" Stroke="Black" StrokeThickness="2" Fill="Transparent"/>

                                        <Grid x:Name="grid_RotatingCentrifuge" RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="cenRotation" Angle="0"/>
                                            </Grid.RenderTransform>

                                            <Border x:Name="thanh1" Width="60" Height="160" Background="#A6A6A6" CornerRadius="10"/>
                                            <Border x:Name="thanh2" Width="160" Height="60" Background="#A6A6A6" CornerRadius="10"/>

                                            <Grid>
                                                <Ellipse x:Name="elTube1_Centrifuge" Width="30" Height="30" Fill="#444444" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0"/>
                                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,0,0,0"/>

                                                <Ellipse x:Name="elTube2_Centrifuge" Width="30" Height="30" Fill="#444444" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,25,0,0"/>
                                                <TextBlock Text="2" Foreground="White" FontWeight="Bold" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,31,0,0"/>

                                                <Ellipse x:Name="elTube3_Centrifuge" Width="30" Height="30" Fill="#444444" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,25,0"/>
                                                <TextBlock Text="3" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,36,0"/>

                                                <Ellipse x:Name="elTube4_Centrifuge" Width="30" Height="30" Fill="#444444" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                                                <TextBlock Text="4" Foreground="White" FontWeight="Bold" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,31"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Viewbox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource BlockBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource MonitorHeader}">
                        <TextBlock Text="Level" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name="txt_MainPlasmaVol" Text="Plasma:" Foreground="#00FF00" FontWeight="Bold" TextAlignment="Left"/>
                            </Border>
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name="txt_MainRbcVol" Text="RBC:" Foreground="#00FF00" FontWeight="Bold" TextAlignment="Left"/>
                            </Border>
                            <Border Style="{StaticResource BlackBoxInfo}">
                                <TextBlock x:Name="txt_MainLiquidStatus" Text="Status:" Foreground="#00FF00" FontWeight="Bold" TextAlignment="Left"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border Width="56" Height="18" Background="DodgerBlue" BorderBrush="Black" BorderThickness="2" CornerRadius="4,4,2,2" Panel.ZIndex="1"/>
                            <Border x:Name="bdr_VisualTube" Width="50" Height="150" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="0,0,25,25" Margin="0,0,0,10"/>
                        </StackPanel>
                        
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource BlockBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource MonitorHeader}">
                        <TextBlock Text="Centrifugation monitor" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Border>

                    <DataGrid x:Name="dgvCentrifugation" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                              RowHeaderWidth="0" Background="White" BorderBrush="Transparent"
                              HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" 
                              RowHeight="35" 
                              VerticalScrollBarVisibility="Disabled" 
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Top"
                              AlternationCount="2" 
                              AlternatingRowBackground="#EAF2F8">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Padding" Value="0,10"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Slot" Binding="{Binding TubeSlot}" Width="150" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Grid.Column="4" Style="{StaticResource BlockBorder}" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="TOTAL ERR:" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.Column="0" Background="#FF3333" BorderBrush="Black" BorderThickness="1" Width="80" Height="35" Margin="0,5,0,10">
                        <TextBlock x:Name="txt_TotalErr" Text="0" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Border>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="TOTAL:" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Grid.Row="1" Grid.Column="1" Background="Black" BorderBrush="Black" BorderThickness="1" Width="80" Height="35" Margin="0,5,0,10">
                        <TextBlock x:Name="txt_Total" Text="0" Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Border>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="TOTAL OK:" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <Border Grid.Row="3" Grid.Column="0" Background="#B5E61D" BorderBrush="Black" BorderThickness="1" Width="80" Height="35" Margin="0,5,0,0">
                        <TextBlock x:Name="txt_TotalOk" Text="0" Foreground="Black" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                    </Border>

                    <!-- NÚT EMG ĐƯỢC CHỈNH TO VÀ NEO VỀ GÓC DƯỚI BÊN PHẢI -->
                    <Viewbox Grid.Row="2" Grid.Column="1" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,0,0" Stretch="Uniform">
                        <Button Cursor="Hand" ToolTip="DỪNG KHẨN CẤP" Width="110" Height="110">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse Fill="#FFD700" Stroke="#B8860B" StrokeThickness="4"/>
                                        <Ellipse Margin="12" Fill="#FF0000" Stroke="#8B0000" StrokeThickness="3">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="270" Opacity="0.6"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="EMG" Foreground="White" FontWeight="Black" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Viewbox>

                </Grid>
            </Border>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Background="#FF9933" BorderBrush="Black" BorderThickness="1" CornerRadius="3">
                <TextBlock x:Name="txt_trangthai" Text="PRESS START TO RUN AUTO" Foreground="Black" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Grid>
</UserControl>