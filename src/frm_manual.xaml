<UserControl x:Class="SCADA_VERTEX.frm_manual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14">

    <UserControl.Resources>
        <Style x:Key="BlockBorder" TargetType="Border">
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="8"/>
        </Style>

        <Style x:Key="HeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="Green"/>
            <Setter Property="Padding" Value="0,5"/>
            <Setter Property="Margin" Value="10,10,10,10"/>
        </Style>

        <Style x:Key="BtnPulse" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#7ED957"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnJog" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleBtnON" TargetType="ToggleButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CCC" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#7ED957"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleBtnActuator" TargetType="ToggleButton">
            <Setter Property="Background" Value="#C0C0C0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#999" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#7ED957"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TbInput" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="TbObserve" TargetType="TextBox">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="#00FF00"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <UniformGrid Rows="2" Columns="3" Margin="10">

        <Border Style="{StaticResource BlockBorder}"  BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Axis X" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,10">
                    <ToggleButton x:Name="btnOnX" Content="ON" Style="{StaticResource ToggleBtnON}" Checked="btnOn1_pressed" Unchecked="btnOn1_notpressed"/>
                    <Button x:Name="btnHomeX" Content="Home" Style="{StaticResource BtnPulse}" Click="btnJogHomeX_Click" />
                    <Button x:Name="btnJogPlusX" Content="JOG +" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogAheadX_pressed" PreviewMouseLeftButtonUp="btnJogAheadX_notpressed" MouseLeave="btnJogAheadX_notpressed"/>
                    <Button x:Name="btnJogMinusX" Content="JOG -" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogBackX_pressed" PreviewMouseLeftButtonUp="btnJogBackX_notpressed" MouseLeave="btnJogBackX_notpressed"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="20,0,20,15" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jog sp:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtJogSpeedX" Text="10" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtJogSpeedX_KeyDown"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Acc/Dec:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAccDecX" Text="0" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtAccDecX_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current pos" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCurrentPosX" Text="0.00" Style="{StaticResource TbObserve}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource BlockBorder}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Axis Y" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,10">
                    <ToggleButton x:Name="btnOnY" Content="ON" Style="{StaticResource ToggleBtnON}" Checked="btnOn2_pressed" Unchecked="btnOn2_notpressed"/>
                    <Button x:Name="btnHomeY" Content="Home" Style="{StaticResource BtnPulse}"  Click="btnJogHomeY_Click"/>
                    <Button x:Name="btnJogPlusY" Content="JOG +" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogAheadY_pressed" PreviewMouseLeftButtonUp="btnJogAheadY_notpressed" MouseLeave="btnJogAheadY_notpressed"/>
                    <Button x:Name="btnJogMinusY" Content="JOG -" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogBackY_pressed" PreviewMouseLeftButtonUp="btnJogBackY_notpressed" MouseLeave="btnJogBackY_notpressed"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="20,0,20,15" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jog sp:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtJogSpeedY" Text="10" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtJogSpeedY_KeyDown"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Acc/Dec:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAccDecY" Text="0" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtAccDecY_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current pos" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCurrentPosY" Text="0.00" Style="{StaticResource TbObserve}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource BlockBorder}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Axis Z" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,10">
                    <ToggleButton x:Name="btnOnZ" Content="ON" Style="{StaticResource ToggleBtnON}" Checked="btnOn3_pressed" Unchecked="btnOn3_notpressed"/>
                    <Button x:Name="btnHomeZ" Content="Home" Style="{StaticResource BtnPulse}" Click="btnJogHomeZ_Click"/>
                    <Button x:Name="btnJogPlusZ" Content="JOG +" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogAheadZ_pressed" PreviewMouseLeftButtonUp="btnJogAheadZ_notpressed" MouseLeave="btnJogAheadZ_notpressed"/>
                    <Button x:Name="btnJogMinusZ" Content="JOG -" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogBackZ_pressed" PreviewMouseLeftButtonUp="btnJogBackZ_notpressed" MouseLeave="btnJogBackZ_notpressed"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="20,0,20,15" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jog sp:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtJogSpeedZ" Text="10" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtJogSpeedZ_KeyDown"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Acc/Dec:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAccDecZ" Text="0" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtAccDecZ_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current pos" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCurrentPosZ" Text="0.00" Style="{StaticResource TbObserve}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource BlockBorder}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Axis R" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,10">
                    <ToggleButton x:Name="btnOnR" Content="ON" Style="{StaticResource ToggleBtnON}" Checked="btnOn4_pressed" Unchecked="btnOn4_notpressed"/>
                    <Button x:Name="btnHomeR" Content="Home" Style="{StaticResource BtnPulse}" Click="btnJogHomeR_Click" />
                    <Button x:Name="btnJogPlusR" Content="JOG +" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogAheadR_pressed" PreviewMouseLeftButtonUp="btnJogAheadR_notpressed" MouseLeave="btnJogAheadR_notpressed"/>
                    <Button x:Name="btnJogMinusR" Content="JOG -" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogBackR_pressed" PreviewMouseLeftButtonUp="btnJogBackR_notpressed" MouseLeave="btnJogBackR_notpressed"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="20,0,20,15" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jog sp:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtJogSpeedR" Text="10" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtJogSpeedR_KeyDown"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="RPM" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Acc/Dec:" VerticalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtAccDecR" Text="0" Style="{StaticResource TbInput}" Margin="0,0,10,12" KeyDown="txtAccDecR_KeyDown"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current pos" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCurrentPosR" Text="0.00" Style="{StaticResource TbObserve}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="deg" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource BlockBorder}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Servo motor" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Margin="10,0,10,5">
                    <ToggleButton x:Name="btnServoOn" Content="Servo ON" Style="{StaticResource ToggleBtnON}" Checked="btnOnServo_pressed" Unchecked="btnOnServo_notpressed"/>
                    <Button x:Name="btnServoHome" Content="Home" Style="{StaticResource BtnPulse}" Click="btnJogHomeServo_Click"/>
                    <Button x:Name="btnServoJogPlus" Content="JOG +" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogAheadServo_pressed" PreviewMouseLeftButtonUp="btnJogAheadServo_notpressed" MouseLeave="btnJogAheadServo_notpressed"/>
                    <Button x:Name="btnServoJogMinus" Content="JOG -" Style="{StaticResource BtnJog}" PreviewMouseLeftButtonDown="btnJogBackServo_pressed" PreviewMouseLeftButtonUp="btnJogBackServo_notpressed" MouseLeave="btnJogBackServo_notpressed"/>
                </UniformGrid>

                <Grid Grid.Row="2" Margin="10,0,10,5" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Jog sp:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtServoJogSp" Text="1500" Style="{StaticResource TbInput}" KeyDown="txtJogSpeedServo_KeyDown" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="RPM" VerticalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Time Acc/Dec:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="txtServoAccDec" Text="500" Style="{StaticResource TbInput}" KeyDown="txtServoAccDec_KeyDown" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" VerticalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Current pos" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="txtServoCurrentPos" Text="0.0" Style="{StaticResource TbObserve}" Margin="0,0,10,8"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="deg" VerticalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Current speed" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtServoCurrentSpeed" Text="0" Style="{StaticResource TbObserve}" Margin="0,0,10,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="RPM" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <Border Style="{StaticResource BlockBorder}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource HeaderBorder}">
                    <TextBlock Text="Actuator" HorizontalAlignment="Center" FontWeight="Bold"/>
                </Border>

                <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="10,5,10,10">
                    <ToggleButton x:Name="tgCylinderA" Content="Cylinder A" Style="{StaticResource ToggleBtnActuator}" Checked="btnOnXLA" Unchecked="btnOffXLA"/>
                    <ToggleButton x:Name="tgCylinderB" Content="Cylinder B" Style="{StaticResource ToggleBtnActuator}" Checked="btnOnXLB" Unchecked="btnOffXLB"/>
                    <ToggleButton x:Name="tgDCMotor1" Content="DC motor 1" Style="{StaticResource ToggleBtnActuator}" Checked="btnOnDC1" Unchecked="btnOffDC1"/>
                    <ToggleButton x:Name="tgDCMotor2" Content="DC motor 2" Style="{StaticResource ToggleBtnActuator}" Checked="btnOnDC2" Unchecked="btnOffDC2"/>
                </UniformGrid>
            </Grid>
        </Border>

    </UniformGrid>
</UserControl>