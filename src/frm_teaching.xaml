<UserControl x:Class="SCADA_VERTEX.frm_teaching"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="15"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#D9D9D9" Padding="20" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="ROBOT CURRENT POSITION" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Axis X:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPosX" Grid.Row="0" Grid.Column="1" Text="0.00" IsReadOnly="True" Background="Black" Foreground="#00FF00" FontWeight="Bold" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="1" Text="Axis Y:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPosY" Grid.Row="1" Grid.Column="1" Text="0.00" IsReadOnly="True" Background="Black" Foreground="#00FF00" FontWeight="Bold" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Text="Axis Z:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPosZ" Grid.Row="2" Grid.Column="1" Text="0.00" IsReadOnly="True" Background="Black" Foreground="#00FF00" FontWeight="Bold" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="3" Text="Axis R:" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtPosR" Grid.Row="3" Grid.Column="1" Text="0.00" IsReadOnly="True" Background="Black" Foreground="#00FF00" FontWeight="Bold" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="deg" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="btnTeachPoint" Content="TEACH CURRENT POS TO ROW ➔" Background="#7ED957" FontWeight="Bold" Height="45" Margin="0,15,0,0" Cursor="Hand" Click="btnTeachPoint_Click"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#D9D9D9" Padding="20" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CENTRIFUGE TEACHING" FontWeight="Bold" Margin="0,0,0,20"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="40"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Current Pos:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCenCurrent" Grid.Row="0" Grid.Column="1" Text="0.0" IsReadOnly="True" Background="Black" Foreground="#FFD700" FontWeight="Bold" FontSize="18" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="deg" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="Spin Velocity:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCenVel" x:FieldModifier="public" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Background="#E0E0E0" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="RPM" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="Spin Time:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCenTime" x:FieldModifier="public" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Background="#E0E0E0" VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,5,10,5"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="sec" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button x:Name="btnCenEdit" Click="btnCenEdit_Click" Content="EDIT" Width="100" Height="35" Background="#0054A6" Foreground="White" FontWeight="Bold" Margin="0,0,15,0" Cursor="Hand" />
                            <Button x:Name="btnCenSave" Click="btnCenSave_Click" Content="SAVE" Width="100" Height="35" Background="#A6A6A6" FontWeight="Bold" Cursor="Hand"  IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="2" Background="#D9D9D9" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="ROBOT SEQUENCE TEACHING:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnSaveDB" Content="SAVE DATABASE" Click="btnSaveDB_Click" Background="#FF7F27" Foreground="White" FontWeight="Bold" Width="180" Height="35" Margin="0,0,15,0" Cursor="Hand"/>
                        <Button x:Name="btnDownloadPLC" Content="DOWNLOAD TO PLC" Click="btnDownloadPLC_Click" Background="#FF3333" Foreground="White" FontWeight="Bold" Width="160" Height="35" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="dgvRobotPoints" AutoGenerateColumns="False" 
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          Background="White" RowHeaderWidth="0" AlternatingRowBackground="#F0F8FF"
                          HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray" 
                          GridLinesVisibility="All" BorderBrush="Gray" BorderThickness="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Point Name" Binding="{Binding PointName}" Width="150" IsReadOnly="True" FontWeight="Bold"/>

                        <DataGridTextColumn Header="X (mm)" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Z (mm)" Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="R (deg)" Binding="{Binding R, UpdateSourceTrigger=PropertyChanged}" Width="80"/>

                        <DataGridTextColumn Header="Vx (mm/s)" Binding="{Binding VelX, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridTextColumn Header="Vy (mm/s)" Binding="{Binding VelY, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridTextColumn Header="Vz (mm/s)" Binding="{Binding VelZ, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                        <DataGridTextColumn Header="Vr (RPM)" Binding="{Binding VelR, UpdateSourceTrigger=PropertyChanged}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>