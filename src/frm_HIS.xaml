<UserControl x:Class="SCADA_VERTEX.frm_HIS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:SCADA_VERTEX"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1820"
             Background="#F4F4F4" FontFamily="Arial" FontSize="14">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#D9D9D9" Padding="20" CornerRadius="5" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="DatabaseAdd" Width="26" Height="26" Foreground="#0054A6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="PATIENT PROFILE (HIS)" FontWeight="Bold" FontSize="16" Foreground="#0054A6" VerticalAlignment="Center"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sample ID:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtID" Grid.Row="0" Grid.Column="1" Height="32" VerticalContentAlignment="Center" CharacterCasing="Upper" Padding="5,0"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Patient Name:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Test Type:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cboType" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0">
                        <ComboBoxItem Content="Chemistry" IsSelected="True"/>
                        <ComboBoxItem Content="Immunity"/>
                        <ComboBoxItem Content="Hematology"/>
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Centrifuge:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <ComboBox x:Name="cboCentrifuge" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0">
                        <ComboBoxItem Content="Yes" IsSelected="True"/>
                        <ComboBoxItem Content="No"/>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Result:" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtResult" Grid.Row="4" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="5,0"/>
                </Grid>

                <Grid Margin="0,25,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnSave" Content="SAVE" Grid.Row="0" Grid.Column="0" Background="#7ED957" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="btnSave_Click"/>
                    <Button x:Name="btnUpdate" Content="UPDATE" Grid.Row="0" Grid.Column="2" Background="#FF7F27" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnUpdate_Click"/>

                    <Button x:Name="btnDelete" Content="DELETE" Grid.Row="2" Grid.Column="0" Background="#FF3333" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnDelete_Click"/>
                    <Button x:Name="btnClear" Content="CLEAR FORM" Grid.Row="2" Grid.Column="2" Background="#A6A6A6" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="btnClear_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#D9D9D9" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="DATABASE: PATIENT PROFILES" FontWeight="Bold" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <materialDesign:PackIcon Kind="ServerNetwork" Width="24" Height="24" Foreground="Green" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="SQL Connected" FontWeight="Bold" Foreground="Green" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2" x:Name="dgvPatientList" AutoGenerateColumns="True" 
                          IsReadOnly="True" SelectionChanged="dgvPatientList_SelectionChanged"
                          Background="White" RowHeaderWidth="0" AlternatingRowBackground="#F0F8FF"
                          HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray" 
                          GridLinesVisibility="All" BorderBrush="Gray" BorderThickness="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>